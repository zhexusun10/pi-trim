{
  "name": "pi-trim",
  "version": "0.2.1",
  "description": "Pi coding agent extension that trims Pi-specific identity and documentation from the system prompt to reduce context usage.",
  "type": "module",
  "license": "MIT",
  "author": "Jerry (zhexusun10)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhexusun10/pi-trim.git"
  },
  "bugs": {
    "url": "https://github.com/zhexusun10/pi-trim/issues"
  },
  "homepage": "https://github.com/zhexusun10/pi-trim#readme",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "pi-extension",
    "coding-agent",
    "system-prompt",
    "context",
    "context-management",
    "token-optimization"
  ],
  "files": [
    "extensions/",
    "lib/",
    "README.md",
    "docs/README.zh-CN.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs/migration.md"
  ],
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ],
    "image": "https://raw.githubusercontent.com/zhexusun10/pi-trim/main/assets/before-after.png",
    "video": "https://raw.githubusercontent.com/zhexusun10/pi-trim/main/assets/demo.mp4"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-ai": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.0.0",
    "@earendil-works/pi-ai": "1.0.0",
    "@types/node": "^22.0.0",
    "gpt-tokenizer": "4.0.0",
    "tsx": "4.23.15",
    "typescript": "~5.9.3"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "benchmark": "tsx scripts/benchmark.ts",
    "benchmark:tasks": "tsx scripts/benchmark-tasks.ts",
    "prepublishOnly": "npm run check && npm test"
  }
}
